---
interface Props {
  title: string;
  classes?: string;
  dataText?: string;
}

const { title, classes, dataText } = Astro.props;
---

<h2
  class=`border-y-2 border-first-color py-3 my-6 mx-auto w-60 text-center font-semibold text-text-dark-color ${classes && classes}`
  data-text={dataText}
>
  {title}
</h2>
