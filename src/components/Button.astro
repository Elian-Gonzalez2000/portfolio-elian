---
interface ButtonProps {
  id?: string | undefined;
  href: string;
  rel?:
    | "noopener"
    | "noreferrer"
    | "nofollow"
    | "canonical"
    | "dns-prefetch"
    | "preconnect"
    | "prefetch"
    | "prerender"
    | "stylesheet"
    | "alternate"
    | "author"
    | "help"
    | "icon"
    | "license"
    | "manifest"
    | "modulepreload"
    | "pingback"
    | "search"
    | "tag"
    | "privacy-policy";
  target: "_blank | _self | _parent | _top";
  text?: string;
  classes?: string;
  icon?: string;
  iconSide?: "left" | "right";
  textColor?: string;
  bgColor?: string;
  textHoverColor?: string;
  bgHoverColor?: string;
  margin?: string;
  width?: string;
}

const {
  id,
  href,
  text,
  classes,
  rel,
  target,
  icon,
  iconSide = "left",
  textColor = "text-text-light-color",
  textHoverColor = "hover:text-text-dark-color",
  bgColor = "bg-blue-500",
  bgHoverColor = "hover:bg-gray-300",
  margin = "mb-3",
  width = "w-4/5",
} = Astro.props as ButtonProps;
---

<!-- create a buttom component for astro -->
<a
  id={id}
  href={href}
  rel={rel}
  target={target}
  class={`${classes && classes} ${margin} flex justify-center items-center ${width} py-2 ${bgColor} ${textColor} border-2 border-gray-800 rounded-md transition duration-300 ${bgHoverColor} ${textHoverColor}`}
  ><slot />
  {` ${text ? text : ""} `}
</a>

<style></style>
