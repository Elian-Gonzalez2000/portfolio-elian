---

---

<header
  class="fixed bottom-0 left-0 right-0 lg:bottom-auto h-16 lg:h-fit bg-first-color z-[1000]"
>
  <section
    class="container mx-auto flex justify-between items-center py-4 px-4 lg:py-2 text-text-light-color"
  >
    <div class="logo w-3/4 lg:w-1/3 flex items-center gap-2">
      <h2 class="text-text-light-color text-lg lg:text-2xl">Elian Gonzalez</h2>
      <div class="flex gap-2 items-center">
        <picture class="w-auto">
          <img
            class="flag spain lg:w-auto border border-transparent hover:border-black-color hover:cursor-pointer border-solid w-7"
            src="../../public/icons8-españa-48.png"
            alt="spanish"
          />
        </picture>
        <picture>
          <img
            class="flag english lg:w-auto border border-transparent hover:border-black-color hover:cursor-pointer w-6 border-solid"
            src="../../public/icons8-inglaterra-40.png"
            alt="english"
          />
        </picture>
      </div>
    </div>

    <div
      class="menu-btn w-9 h-9 border border-gray-200 flex justify-center items-center rounded-full transition-all duration-300 hover:text-first-color hover:bg-gray-light-color lg:hidden cursor-pointer"
    >
      <svg
        aria-hidden="true"
        focusable="false"
        data-prefix="fas"
        data-icon="bars"
        class="svg-inline--fa fa-bars fa-w-14 w-5 h-5"
        role="img"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 448 512"
      >
        <path
          fill="currentColor"
          d="M16 132h416c8.837 0 16-7.163 16-16V76c0-8.837-7.163-16-16-16H16C7.163 60 0 67.163 0 76v40c0 8.837 7.163 16 16 16zm0 160h416c8.837 0 16-7.163 16-16v-40c0-8.837-7.163-16-16-16H16c-8.837 0-16 7.163-16 16v40c0 8.837 7.163 16 16 16zm0 160h416c8.837 0 16-7.163 16-16v-40c0-8.837-7.163-16-16-16H16c-8.837 0-16 7.163-16 16v40c0 8.837 7.163 16 16 16z"
        ></path>
      </svg>
    </div>

    <nav
      class="nav fixed top-0 left-0 right-0 bottom-16 bg-first-alpha-color border-b-2 border-black-gray-color z-[999] transform translate-x-full transition-transform duration-500 lg:relative lg:translate-x-0 lg:bg-transparent lg:border-none"
    >
      <ul
        class="flex flex-col lg:gap-5 lg:flex-row lg:items-center mt-2 lg:mt-0"
      >
        <li class="w-full text-center">
          <a
            href="#home"
            data-scroll-spy
            data-text="headerLinkHome"
            class="block text-gray-light-color text-lg py-4 lg:px-2.5 lg:py-1.5 lg:rounded-md w-full hover:opacity-100 hover:text-text-dark-color hover:bg-gray-200 transition-all duration-200"
            >Inicio</a
          >
        </li>
        <li class="w-full text-center">
          <a
            href="#about"
            data-text="headerLinkAbout"
            data-scroll-spy
            class="block text-gray-light-color text-lg py-4 lg:px-2.5 lg:py-1.5 lg:rounded-md w-full hover:opacity-100 hover:text-text-dark-color hover:bg-gray-200 transition-all duration-200"
            >Acerca</a
          >
        </li>
        <li class="w-full text-center">
          <a
            href="#projects"
            data-text="headerLinkProjects"
            data-scroll-spy
            class="block text-gray-light-color text-lg py-4 lg:px-2.5 lg:py-1.5 lg:rounded-md w-full hover:opacity-100 hover:text-text-dark-color hover:bg-gray-200 transition-all duration-200"
            >Proyectos</a
          >
        </li>
        <li class="w-full text-center">
          <a
            href="#services"
            data-text="headerLinkServices"
            data-scroll-spy
            class="block text-gray-light-color text-lg py-4 lg:px-2.5 lg:py-1.5 lg:rounded-md w-full hover:opacity-100 hover:text-text-dark-color hover:bg-gray-200 transition-all duration-200"
            >Servicios</a
          >
        </li>

        <li class="w-full text-center">
          <a
            href="#contact"
            data-text="headerLinkContact"
            data-scroll-spy
            class="block text-gray-light-color text-lg py-4 lg:px-2.5 lg:py-1.5 lg:rounded-md w-full hover:opacity-100 hover:text-text-dark-color hover:bg-gray-200 transition-all duration-200"
            >Contacto</a
          >
        </li>
      </ul>
    </nav>
  </section>
</header>

<script>
  function hamburguerMenu(menu, menubtn, menuLink) {
    document.addEventListener("click", (e) => {
      if (
        e.target instanceof HTMLDivElement ||
        e.target instanceof SVGElement
      ) {
        if (e.target.matches(menubtn) || e.target.matches(`${menubtn} *`)) {
          document.querySelector(menu).classList.toggle("translate-x-full");
          document.querySelector(menubtn).classList.toggle("rotate-90");
          document.querySelector(menubtn).classList.toggle("text-first-color");
          document
            .querySelector(menubtn)
            .classList.toggle("bg-gray-light-color");
        }

        if (e.target.matches(menuLink)) {
          document.querySelector(menu).classList.add("translate-x-full");
        }
      }
    });
  }

  function changeLanguage() {
    const flags = document.querySelectorAll(".flag");
    if (!localStorage.getItem("language"))
      localStorage.setItem("language", "spanish");
    flags.forEach((flag: HTMLImageElement) => {
      flag.addEventListener("click", (e: Event) => {
        console.log(flag.alt, localStorage.getItem("language"));

        if (localStorage.getItem("language") === flag.alt) return;
        localStorage.setItem("language", flag.alt);
        location.reload();
      });
    });
  }
  hamburguerMenu(".nav", ".menu-btn", ".nav ul li a");
  changeLanguage();
</script>
