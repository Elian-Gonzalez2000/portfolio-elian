---
import Button from "../components/Button.astro";
import SectionTitle from "../components/SectionTitle.astro";
---

<section
  class="about mt-4 mb-10 px-7 min-h-screen flex items-center"
  id="about"
  data-scroll-spy
>
  <div
    class="container mx-auto grid grid-cols-1 lg:grid-cols-2 justify-between items-start"
  >
    <SectionTitle
      title="Acerca de mi"
      classes="lg:col-span-2 mb-9"
      dataText="aboutSectionTitle"
    />
    <div class="about-content mb-10">
      <h3 class="text-2xl mb-5" data-text="aboutTextH3">¿Quien Soy?</h3>
      <h4 class="text-2xl leading-9 mb-6" data-text="aboutTextH4">
        Soy Elian Gonzalez, Fullstack Developer
      </h4>
      <p class="leading-9" data-text="aboutTextParagraph1">
        Soy un desarrollador Fullstack apasionado por crear soluciones digitales
        eficientes y funcionales. Cuento con experiencia en tecnologías clave
        como React, JavaScript, Node.js, SQL y CSS, entre otras herramientas
        esenciales en el desarrollo web moderno.
      </p>
      <br />
      <p class="leading-9" data-text="aboutTextParagraph2">
        Siempre estoy en búsqueda de aprender y perfeccionar tanto mis
        habilidades técnicas como mis competencias personales, lo que me permite
        adaptarme a las necesidades cambiantes del sector tecnológico.
      </p>
      <br />
      <p class="leading-9" data-text="aboutTextParagraph3">
        Disfruto diseñar y desarrollar interfaces web intuitivas y atractivas,
        ya sea trabajando de manera individual o como parte de un equipo, con el
        objetivo de aportar un impacto positivo a cada proyecto en el que
        participo.
      </p>
      <br />
      <p class="leading-9" data-text="aboutTextParagraph4">
        Además, tengo experiencia en el desarrollo y mantenimiento de APIs en el
        backend, aplicando buenas prácticas, metodologías ágiles y técnicas de
        optimización para garantizar sistemas robustos y escalables.
      </p>
      <Button
        href="https://drive.google.com/file/d/1QNRSdwhpLqraL-5AL0ZqOJCwafMorgJN/view"
        classes="W-3/4 sm:w-1/2 btn mt-6 flex justify-center items-center text-text-light-color border-solid border-2 hover:border-first-color p-2 rounded hover:bg-gray-light-color hover:opacity-100"
        target="_blank"
        textHoverColor="hover:text-first-color"
        bgColor="bg-first-color"
      >
        <svg
          aria-hidden="true"
          focusable="false"
          data-prefix="far"
          data-icon="file-pdf"
          class="svg-inline--fa fa-file-pdf fa-w-12 w-6 mr-4"
          role="img"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 384 512"
        >
          <path
            fill="currentColor"
            d="M369.9 97.9L286 14C277 5 264.8-.1 252.1-.1H48C21.5 0 0 21.5 0 48v416c0 26.5 21.5 48 48 48h288c26.5 0 48-21.5 48-48V131.9c0-12.7-5.1-25-14.1-34zM332.1 128H256V51.9l76.1 76.1zM48 464V48h160v104c0 13.3 10.7 24 24 24h104v288H48zm250.2-143.7c-12.2-12-47-8.7-64.4-6.5-17.2-10.5-28.7-25-36.8-46.3 3.9-16.1 10.1-40.6 5.4-56-4.2-26.2-37.8-23.6-42.6-5.9-4.4 16.1-.4 38.5 7 67.1-10 23.9-24.9 56-35.4 74.4-20 10.3-47 26.2-51 46.2-3.3 15.8 26 55.2 76.1-31.2 22.4-7.4 46.8-16.5 68.4-20.1 18.9 10.2 41 17 55.8 17 25.5 0 28-28.2 17.5-38.7zm-198.1 77.8c5.1-13.7 24.5-29.5 30.4-35-19 30.3-30.4 35.7-30.4 35zm81.6-190.6c7.4 0 6.7 32.1 1.8 40.8-4.4-13.9-4.3-40.8-1.8-40.8zm-24.4 136.6c9.7-16.9 18-37 24.7-54.7 8.3 15.1 18.9 27.2 30.1 35.5-20.8 4.3-38.9 13.1-54.8 19.2zm131.6-5s-5 6-37.3-7.8c35.1-2.6 40.9 5.4 37.3 7.8z"
          >
          </path>
        </svg>
        <p
          class="inline-block text-xl font-normal text-inherit"
          data-text="aboutLinkDownloadCV"
        >
          Descargar CV
        </p>
      </Button>
    </div>
