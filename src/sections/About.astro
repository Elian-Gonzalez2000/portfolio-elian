<style>
  /* ----- About Section ----- */
  .skills-img:hover,
  .skills-img.active-animation {
    animation: skills-animations 1.1s ease-in alternate;
  }

  .skills-img:hover p,
  .skills-img.active-animation p {
    transform: rotate(0deg);
  }

  @keyframes skills-animations {
    10% {
      transform: rotate(20deg);
    }

    25% {
      transform: rotate(-20deg);
    }

    50% {
      transform: rotate(20deg);
    }

    60% {
      transform: rotate(-20deg);
    }

    70% {
      transform: rotate(20deg);
    }

    80% {
      transform: rotate(-20deg);
    }

    90% {
      transform: rotate(20deg);
    }

    100% {
      transform: rotate(0deg);
    }
  }

  /* ---- Boton general ---- */
  .skills-img svg {
    width: 4rem;
    margin: 0 auto;
  }

  .skills-img.html5 {
    color: #e34c26;
  }

  .skills-img.css3 {
    color: #264de4;
  }

  .skills-img.javascript {
    color: #f0db4f;
  }

  .skills-img.git {
    color: #f34f29;
  }

  .skills-img.node {
    color: #68a063;
  }

  .skills-img.postgres {
    color: #336791;
  }

  .skills-img.mongo {
    color: #58aa50;
  }

  .skills-img.react {
    color: #61dbfb;
  }

  .skills-img.redux {
    color: #764abc;
  }

  .skills-img.figma {
    color: #e04a34;
  }
</style>

<script>
  // Mantein the animation when the mouse is over the image
  document.querySelectorAll(".skills-img").forEach((element) => {
    element.addEventListener("mouseenter", () => {
      element.classList.add("active-animation");
    });

    element.addEventListener("animationend", () => {
      element.classList.remove("active-animation");
    });
  });
</script>
