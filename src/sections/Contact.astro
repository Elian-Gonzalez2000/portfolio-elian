---
import SectionTitle from "../components/SectionTitle.astro";
---

<section
  class="contact min-h-screen mb-0 flex justify-center items-center"
  id="contact"
  data-scroll-spy
>
  <div
    class="haero-image"
    style="--hero-image: url(https://i.ibb.co/HzfF2BS/hero-image-contact.jpg); --hero-attachment: fixed;"
  >
    <aside
      class="hero-image-opacity"
      style="--hero-opacity-color: var(--black-alpha-color)"
    >
      <div
        class="container flex flex-col justify-center items-center py-8 px-5"
      >
        <div class="mb-10 text-text-light-color">
          <SectionTitle title="¿Interesad@?" classes="section-title" />
        </div>
        <div
          class="contact-cards grid grid-cols-1 md:grid-cols-2 justify-evenly content-center items-center gap-x-4 gap-y-4 w-full mb-8"
        >
          <div class="contact-card card box-shadow-1">
            <svg
              width="37"
              height="28"
              viewBox="0 0 37 28"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M18.5 7.3125L7 16.8125V27C7 27.5625 7.4375 28 8 28H15C15.5 28 15.9375 27.5625 15.9375 27V21C15.9375 20.5 16.4375 20 16.9375 20H20.9375C21.5 20 21.9375 20.5 21.9375 21V27C21.9375 27.5625 22.4375 28 22.9375 28H30C30.5 28 31 27.5625 31 27V16.75L19.4375 7.3125C19.3125 7.1875 19.125 7.125 19 7.125C18.8125 7.125 18.625 7.1875 18.5 7.3125ZM36.6875 13.75L31.5 9.4375V0.8125C31.5 0.375 31.125 0.0625 30.75 0.0625H27.25C26.8125 0.0625 26.5 0.375 26.5 0.8125V5.3125L20.875 0.6875C20.375 0.3125 19.6875 0.0625 19 0.0625C18.25 0.0625 17.5625 0.3125 17.0625 0.6875L1.25 13.75C1.0625 13.875 0.9375 14.125 0.9375 14.3125C0.9375 14.5 1.0625 14.6875 1.125 14.8125L2.75 16.75C2.875 16.9375 3.0625 17 3.3125 17C3.5 17 3.6875 16.9375 3.8125 16.8125L18.5 4.75C18.625 4.625 18.8125 4.5625 19 4.5625C19.125 4.5625 19.3125 4.625 19.4375 4.75L34.125 16.8125C34.25 16.9375 34.4375 17 34.625 17C34.875 17 35.0625 16.9375 35.1875 16.75L36.8125 14.8125C36.9375 14.6875 37 14.5 37 14.3125C37 14.125 36.875 13.875 36.6875 13.75Z"
                fill="currentColor"></path>
            </svg>
            <h3 class="text-lg mb-0">UBICACION</h3>
            <p class="text-base">España, Barcelona</p>
          </div>
          <div class="contact-card card box-shadow-1">
            <svg
              width="33"
              height="32"
              viewBox="0 0 33 32"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M31.8125 1.5625L25.3125 0.0625C24.625 -0.125 23.875 0.25 23.5625 0.9375L20.5625 7.9375C20.3125 8.5625 20.5 9.25 21 9.6875L24.8125 12.8125C22.5625 17.5625 18.625 21.5625 13.75 23.875L10.625 20.0625C10.1875 19.5625 9.5 19.375 8.875 19.625L1.875 22.625C1.1875 22.9375 0.875 23.6875 1 24.375L2.5 30.875C2.6875 31.5625 3.25 32 4 32C20 32 33 19.0625 33 3C33 2.3125 32.5 1.75 31.8125 1.5625Z"
                fill="currentColor"></path>
            </svg>
            <h3 class="text-lg mb-0">TELEFONO</h3>
            <p class="text-base">(+34) 661557738</p>
          </div>
          <div
            class="contact-card card box-shadow-1 social-media md:col-span-2 md:w-2/4 md:mx-auto md:my-0"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
            >
              <path
                fill="currentColor"
                d="M16.018,3.815L15.232,8h-4.966l0.716-3.815L9.018,3.815L8.232,8H4v2h3.857l-0.751,4H3v2h3.731l-0.714,3.805l1.965,0.369 L8.766,16h4.966l-0.714,3.805l1.965,0.369L15.766,16H20v-2h-3.859l0.751-4H21V8h-3.733l0.716-3.815L16.018,3.815z M14.106,14H9.141 l0.751-4h4.966L14.106,14z"
              ></path>
            </svg>
            <h3 class="text-lg mb-0">SOCIAL MEDIA</h3>
            <div class="flex justify-center items-center gap-4">
              <a
                href="https://linkedin.com/in/elian-gonzalez-developer"
                target="_blank"
                rel="noopener"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                >
                  <path
                    fill="currentColor"
                    d="M20,3H4C3.447,3,3,3.448,3,4v16c0,0.552,0.447,1,1,1h16c0.553,0,1-0.448,1-1V4C21,3.448,20.553,3,20,3z M8.339,18.337H5.667	v-8.59h2.672V18.337z M7.003,8.574c-0.856,0-1.548-0.694-1.548-1.548s0.691-1.548,1.548-1.548c0.854,0,1.548,0.693,1.548,1.548	S7.857,8.574,7.003,8.574z M18.338,18.337h-2.669V14.16c0-0.996-0.018-2.277-1.388-2.277c-1.39,0-1.601,1.086-1.601,2.207v4.248	h-2.667v-8.59h2.56v1.174h0.037c0.355-0.675,1.227-1.387,2.524-1.387c2.704,0,3.203,1.778,3.203,4.092V18.337z"
                  ></path>
                </svg>
              </a>
              <a
                href="https://github.com/Elian-Gonzalez2000
                    "
                target="_blank"
                rel="noopener"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                >
                  <path
                    fill-rule="evenodd"
                    fill="currentColor"
                    clip-rule="evenodd"
                    d="M12.026,2c-5.509,0-9.974,4.465-9.974,9.974c0,4.406,2.857,8.145,6.821,9.465	c0.499,0.09,0.679-0.217,0.679-0.481c0-0.237-0.008-0.865-0.011-1.696c-2.775,0.602-3.361-1.338-3.361-1.338	c-0.452-1.152-1.107-1.459-1.107-1.459c-0.905-0.619,0.069-0.605,0.069-0.605c1.002,0.07,1.527,1.028,1.527,1.028	c0.89,1.524,2.336,1.084,2.902,0.829c0.091-0.645,0.351-1.085,0.635-1.334c-2.214-0.251-4.542-1.107-4.542-4.93	c0-1.087,0.389-1.979,1.024-2.675c-0.101-0.253-0.446-1.268,0.099-2.64c0,0,0.837-0.269,2.742,1.021	c0.798-0.221,1.649-0.332,2.496-0.336c0.849,0.004,1.701,0.115,2.496,0.336c1.906-1.291,2.742-1.021,2.742-1.021	c0.545,1.372,0.203,2.387,0.099,2.64c0.64,0.696,1.024,1.587,1.024,2.675c0,3.833-2.33,4.675-4.552,4.922	c0.355,0.308,0.675,0.916,0.675,1.846c0,1.334-0.012,2.41-0.012,2.737c0,0.267,0.178,0.577,0.687,0.479	C19.146,20.115,22,16.379,22,11.974C22,6.465,17.535,2,12.026,2z"
                  ></path>
                </svg>
              </a>
            </div>
          </div>
        </div>
        <form class="contact-form md:max-w-2xl md:px-2 md:py-6">
          <div class="w-full md:w-6/12 md:pr-4">
            <input
              class="font-size w-full text-text-dark-color p-2 mb-4 border border-solid border-first-color rounded-md shadow-md outline-none transition-all duration-300 focus:border-first-color md:w-full md:p-2"
              type="text"
              name="name"
              placeholder="Ingresa tu nombre"
              title="Nombre solo admite letras y espacios en blanco"
              pattern="^[A-Za-zÑñÁáÉéÍíÓóÚúÜü\s]+$"
              required
            />
          </div>
          <div class="w-full md:w-6/12 md:pl-4">
            <input
              class="font-size w-full text-text-dark-color p-2 mb-4 border border-solid border-first-color rounded-md shadow-md outline-none transition-all duration-300 focus:border-first-color placeholder:text-gray-dark-color md:w-full md:p-2"
              type="email"
              name="email"
              placeholder="Ingresa tu correo electronico"
              title="El correo introducido no es valido"
              pattern="^[a-z0-9]+(\.[_a-z0-9]+)*@[a-z0-9-]+(\.[a-z0-9-]+)*(\.[a-z]{2,15})$"
              required
            />
          </div>
          <textarea
            name="comments"
            class="text-sm w-full h-44 text-text-dark-color shadow-md rounded-md p-2 mb-4 border border-solid border-first-color outline-none transition-all duration-300 resize-none focus:border-first-color placeholder:text-gray-dark-color"
            cols="50"
            rows="5"
            placeholder="Dejame tus comentarios"
            title="No se exceda de los 255 caracteres"
            data-pattern="^.{1,255}$"
            required></textarea>
          <input
            class="font-size max-w-48 w-full text-lg font-semibold bg-first-color text-text-light-color border border-solid border-gray-light-color p-2 mb-4 mt-6 mx-auto cursor-pointer rounded-md shadow-md outline-none transition-all duration-300 hover:text-first-color hover:bg-gray-light-color hover:border-first-color placeholder:text-gray-dark-color m-x-auto"
            type="submit"
            value="Enviar"
          />
        </form>
      </div>
    </aside>
  </div>
  <aside id="gracias" class="modal opacity-0 invisible">
    <div class="contact-form-loader none">
      <img src="assets/loader.svg" alt="Enviando..." />
    </div>
    <div class="modal-content opacity-0 invisible">
      <article class="contact-form-response">
        <h3>
          ¡Muchas Gracias!
          <br />
          <br />
          Por Contactarme
        </h3>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
        >
          <path fill="currentColor" d="M12,18c4,0,5-4,5-4H7C7,14,8,18,12,18z"
          ></path>
          <path
            fill="currentColor"
            d="M12,2C6.486,2,2,6.486,2,12c0,5.514,4.486,10,10,10s10-4.486,10-10C22,6.486,17.514,2,12,2z M12,20c-4.411,0-8-3.589-8-8 s3.589-8,8-8s8,3.589,8,8S16.411,20,12,20z"
          ></path>
          <path
            fill="currentColor"
            d="M13 12l2 .012C15.012 11.55 15.194 11 16 11s.988.55 1 1h2c0-1.206-.799-3-3-3S13 10.794 13 12zM8 11c.806 0 .988.55 1 1h2c0-1.206-.799-3-3-3s-3 1.794-3 3l2 .012C7.012 11.55 7.194 11 8 11z"
          ></path>
        </svg>
      </article>
    </div>
    <div id="error" class="modal-content opacity-0 invisible">
      <article class="contact-form-response">
        <h3>
          ¡Ocurrio un Error!
          <br />
          <br />
          Intentelo Nuevamente
        </h3>
      </article>
    </div>
  </aside>
</section>

<style>
  /* ----- Contact Section ----- */
  .card {
    padding: 2rem;
    background-color: var(--white-color);
    border-radius: 3px;
    box-shadow: 0 0 1rem rgba(221, 221, 221, 0.4);
    text-align: center;
  }

  .contact-cards .contact-card svg {
    width: 2.5rem;
    height: 2.5rem;
    color: var(--first-color);
    margin-bottom: 1rem;
    transition: 0.3s all ease;
    margin-left: auto;
    margin-right: auto;
  }

  .contact-cards .contact-card:hover svg {
    color: var(--second-color);
  }

  .contact-cards .contact-card div svg {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--black-gray-color);
    margin: 0 0.5rem;
    margin-bottom: 0;
    margin-left: auto;
    margin-right: auto;
    cursor: pointer;
  }

  .contact-cards .contact-card div svg:hover {
    color: var(--second-color);
  }

  .contact-form {
    --form-ok-color: #4caf50;
    --form-error-color: #f44336;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    border: medium solid var(--first-color);
    border-radius: 5px;
    box-shadow: 0.25rem 0.25rem 1rem rgba(0, 0, 0, 0.25);
    background-color: var(--white-color);
    width: 100%;
    padding: 1.5rem 1rem;
  }

  .contact-form input:focus {
    border: 1px solid var(--first-color);
    outline: none;
  }

  .contact-form textarea:focus {
    border: 1px solid var(--first-color);
    outline: none;
  }

  .contact-form *::placeholder {
    color: #666;
  }

  .contact-form [required]:valid {
    border: thin solid var(--form-ok-color);
  }

  .contact-form-error {
    margin-top: -1rem;
    font-size: 80%;
    background-color: var(--form-error-color);
    border-radius: 5px;
    color: #fff;
    transition: all 800ms ease;
    padding: 0.5rem;
    margin-bottom: 0.5rem;
    display: none;
    width: 100%;
  }

  .contact-form-error.is-active {
    display: block;
    animation: show-message 1s 1 normal 0s ease-out both;
  }

  .none {
    display: none;
  }

  /* Contact Response Modal */
  .contact .modal {
    position: fixed;
    top: 0;
    bottom: 0;
    right: 0;
    left: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    background-color: var(--black-alpha-color);
    z-index: 2000;
    transition: 0.5s all ease;
  }

  .contact .modal .contact-form-loader {
    width: 5rem;
    height: 5rem;
  }

  .contact .modal .modal-content {
    position: absolute;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 90vw;
    height: 50vh;
    color: var(--text-light-color);
    background-color: var(--first-alpha-color);
    transition: 0.7s all ease;
  }

  .contact .modal .modal-content .contact-form-response h3 {
    letter-spacing: 2px;
    font-size: 1.2rem;
    margin-bottom: 1rem;
  }

  .contact .modal .modal-content svg {
    width: 3.5rem;
    height: 3.5rem;
    color: var(--gray-light-color);
  }

  @keyframes show-message {
    0% {
      visibility: hidden;
      opacity: 0;
    }

    100% {
      visibility: visible;
      opacity: 1;
    }
  }

  @media screen and (min-width: 768px) {
    .contact-form-error {
      width: 100%;
      padding-left: 0;
      padding-right: 0;
    }

    .contact .modal .modal-content {
      width: 60vw;
      height: 50vh;
    }
  }

  @media screen and (min-width: 992px) {
    .contact .container .contact-cards {
      grid-template-columns: repeat(3, 1fr);
    }

    .contact .container .contact-cards .contact-card.social-media {
      grid-column: span 1;
      width: 100%;
    }
  }
</style>

<script>
  function sendContactForm() {
    document.addEventListener("submit", (e: Event) => {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const $gracias = document.getElementById("gracias"),
        $errorResponse = document.getElementById("error"),
        $formResponse = document.querySelector(".modal#gracias .modal-content"),
        $formLoader = document.querySelector(".contact-form-loader");

      $gracias.classList.remove("opacity-0");
      $gracias.classList.remove("invisible");
      $formLoader.classList.remove("none");

      console.log($gracias, $errorResponse, $formResponse, $formLoader);
      fetch("https://formsubmit.co/ajax/eliancarlogm@gmail.com", {
        method: "POST",
        body: new FormData(form),
      })
        .then((res) => (res.ok ? res.json() : Promise.reject(res)))
        .then((data) => {
          //console.log(data);
          $formResponse.classList.remove("opacity-0");
          $formResponse.classList.remove("invisible");
          form.reset();
        })
        .catch((error) => {
          //console.log(error);
          $errorResponse.classList.remove("opacity-0");
          $errorResponse.classList.remove("invisible");
        })
        .finally(() => {
          $formLoader.classList.add("none");
          if (
            $formResponse.classList.contains("opacity-0") &&
            $formResponse.classList.contains("invisible") &&
            $errorResponse.classList.contains("invisible") &&
            $errorResponse.classList.contains("opacity-0")
          ) {
            $gracias.classList.add("opacity-0");
            $gracias.classList.add("invisible");
          } else {
            setTimeout(() => {
              $formResponse.classList.add("opacity-0");
              $formResponse.classList.add("invisible");
              $errorResponse.classList.add("opacity-0");
              $errorResponse.classList.add("invisible");
              $gracias.classList.add("opacity-0");
              $gracias.classList.add("invisible");
            }, 2000);
          }
        });
    });
  }
  document.addEventListener("DOMContentLoaded", sendContactForm);
</script>
