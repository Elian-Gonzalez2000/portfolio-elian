---
import Button from "../components/Button.astro";
import SectionTitle from "../components/SectionTitle.astro";

const response = await fetch("http://localhost:4321/src/data.json");
const data = await response.json();
await console.log(data.projects);
---

<section
  class="projects min-h-screen px-5 pb-4 mb-8 flex justify-center items-center"
  id="projects"
  data-scroll-spy
>
  <div class="container grid grid-cols-1 items-center text- justify-center">
    <div>
      <SectionTitle title="Mis Proyectos" classes="mb-10" />
    </div>
    <div>
      <p class="mb-10">Estos son algunos de mis proyectos realizados:</p>
    </div>
    <div
      class="projects-container grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 justify-evenly items-center gap-4"
    >
      {
        data &&
          data.projects.map((proj) => (
            <article class="project-card w-full justify-center items-center rounded-lg overflow-hidden">
              <div class="project-img overflow-hidden border-b-2 border-solid border-first-color">
                <img
                  class="transition-all duration-300 hover:scale-110"
                  src={proj.urlImage}
                  alt={proj.name}
                />
              </div>
              <aside class="project-card-info mb-4 md:mb-0 flex flex-col flex-wrap justify-evenly items-center gap-3 px-5 py-4 w-full text-text-dark-color bg-white-color transition-all duration-300">
                <h4 class="text-2xl text-first-color">{proj.name}</h4>
                <p class="text-sm">{proj.description}</p>
                <div class="project-card-link w-full flex justify-evenly gap-3">
                  <Button
                    href={`${proj.urlweb}`}
                    target="_blank"
                    rel="noopener"
                    classes="btn max-w-36 inline-block p-2 border-2 border-solid border-text-dark-color font-semibold text-center transition-all duration-200 text-sm max-w-32"
                    textColor="text-text-dark-color"
                    textHoverColor="hover:text-text-light-color"
                    bgColor="bg-white-color"
                    bgHoverColor="hover:bg-second-color"
                    margin="my-0"
                    width="w-11/12"
                  >
                    Web Site{" "}
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="w-5 h-5 object-contain ml-1"
                    >
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                      <polyline points="15 3 21 3 21 9" />
                      <line x1="10" x2="21" y1="14" y2="3" />
                    </svg>
                  </Button>

                  <Button
                    href={`${proj.urlGithub}`}
                    target="_blank"
                    rel="noopener"
                    classes="btn max-w-36 inline-block p-2 border-2 border-solid border-text-dark-color font-semibold text-center transition-all duration-200 text-sm max-w-32"
                    textColor="text-text-light-color"
                    textHoverColor="hover:text-text-light-color"
                    bgColor="bg-first-color"
                    bgHoverColor="hover:bg-second-color"
                    margin="my-0"
                  >
                    Codigo{" "}
                    <svg
                      class="w-6 h-6 object-contain ml-1"
                      xmlns="http://www.w3.org/2000/svg"
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                    >
                      <path
                        fill-rule="evenodd"
                        fill="currentColor"
                        clip-rule="evenodd"
                        d="M12.026,2c-5.509,0-9.974,4.465-9.974,9.974c0,4.406,2.857,8.145,6.821,9.465	c0.499,0.09,0.679-0.217,0.679-0.481c0-0.237-0.008-0.865-0.011-1.696c-2.775,0.602-3.361-1.338-3.361-1.338	c-0.452-1.152-1.107-1.459-1.107-1.459c-0.905-0.619,0.069-0.605,0.069-0.605c1.002,0.07,1.527,1.028,1.527,1.028	c0.89,1.524,2.336,1.084,2.902,0.829c0.091-0.645,0.351-1.085,0.635-1.334c-2.214-0.251-4.542-1.107-4.542-4.93	c0-1.087,0.389-1.979,1.024-2.675c-0.101-0.253-0.446-1.268,0.099-2.64c0,0,0.837-0.269,2.742,1.021	c0.798-0.221,1.649-0.332,2.496-0.336c0.849,0.004,1.701,0.115,2.496,0.336c1.906-1.291,2.742-1.021,2.742-1.021	c0.545,1.372,0.203,2.387,0.099,2.64c0.64,0.696,1.024,1.587,1.024,2.675c0,3.833-2.33,4.675-4.552,4.922	c0.355,0.308,0.675,0.916,0.675,1.846c0,1.334-0.012,2.41-0.012,2.737c0,0.267,0.178,0.577,0.687,0.479	C19.146,20.115,22,16.379,22,11.974C22,6.465,17.535,2,12.026,2z"
                      />
                    </svg>
                  </Button>
                </div>
              </aside>
            </article>
          ))
      }
    </div>
  </div>

  <style>
    /* ---- Projects Section ---- */
    .projects
      .container
      .projects-container
      .project-card:hover
      .project-card-info
      h3 {
      color: var(--first-color);
    }

    @media screen and (min-width: 768px) {
      .contact .container .contact-cards {
        grid-template-columns: repeat(2, 1fr);
      }

      .contact .container .contact-cards .contact-card.social-media {
        grid-column: span 2;
        width: 50%;
        margin: 0 auto;
      }

      .contact .container .contact-form {
        justify-content: space-between;
        max-width: 650px;
        padding: 1.5rem 1rem;
      }

      .contact .container .contact-form div {
        width: 47%;
      }

      .contact .container .contact-form input {
        width: 100%;
        padding: 0.5rem;
      }

      .contact-form-error {
        width: 100%;
        padding-left: 0;
        padding-right: 0;
      }

      .contact .modal .modal-content {
        width: 60vw;
        height: 50vh;
      }
    }
  </style>
</section>
