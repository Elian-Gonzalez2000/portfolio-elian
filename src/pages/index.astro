/* ----- Customs Properties ----- */

:root {
  --first-color: #1450d2;
  --first-alpha-color: rgba(20, 80, 210, 0.75);
  --second-color: #0096c8;
  --second-alpha-color: rgba(0, 150, 200, 0.75);
  --third-color: #e8d5b5;
  --third-alpha-color: rgba(232, 213, 181, 0.75);
  --four-color: #00ad7e;
  --four-alpha-color: rgba(0, 173, 126, 0.75);
  --five-color: #0078a8;
  --five-alpha-color: rgba(0, 120, 168, 0.75);
  --six-color: #aba9bb;
  --six-alpha-color: rgba(171, 169, 187, 0.75);
  --white-color: #fff;
  --gray-light-color: #f3f3f3;
  --gray-color: #ccc;
  --gray-dark-color: #666;
  --black-gray-color: #222;
  --black-color: #000;
  --link-color: #f6f6f6;
  --title-color: #333;
  --text-dark-color: #222;
  --text-light-color: #f3f3f3;
  --white-alpha-color: rgba(255, 255, 255, 0.5);
  --black-alpha-color: rgba(0, 0, 0, 0.5);
  --background-light: #f3f3f3;
  --background-dark: #111111;
  --font: 'Open Sans', sans-serif;
  --max-width: 1200px;
  --header-height: 4rem;
  --breakpoint-nm: 576px;
  --breakpoint-md: 768px;
  --breakpoint-lg: 992px;
  --breakpoint-xl: 1200px;
}
/* ------ Resets ------ */
html {
  box-sizing: border-box;
  font-family: var(--font);
  font-size: 16px;
  scroll-behavior: smooth;
  background-color: none;
}

*,
*::after,
*::before {
  box-sizing: inherit;
  margin: 0;
  padding: 0;
}

body {
  margin: 0;
  overflow-x: hidden;
  color: var(--text-dark-color);
  background-color: var(--background-light);
}

a {
  color: var(--link-color);
  transition: all 0.5s ease-out;
  text-decoration: none;
}

a:hover {
  opacity: 0.9;
}

h1 {
  margin: 0;
  font-size: 2rem;
}

h2 {
  margin: 0;
  font-size: 1.5rem;
}

h3 {
  margin: 0;
  font-size: 1.25rem;
}

h4 {
  margin: 0;
  font-size: 1rem;
}

h5 {
  margin: 0;
  font-size: 0.85rem;
}

h6 {
  margin: 0;
  font-size: 0.7rem;
}

img {
  vertical-align: top;
  width: 100%;
  height: auto;
}

p {
  line-height: 1.6;
}

ul {
  list-style: none;
}

/* ----- Texto Animado ----- */
.hero-image-title h1#logo div {
  position: relative;
  transition: 0.5s all ease;
  color: var(--white-color);
}

.hero-image-title h1#logo div span {
  position: relative;
  transition: 0.5s all ease;
}

.hero-image-title h1#logo div span.second-child {
  position: absolute;
  top: 2.1rem;
  left: 0;
}

.hero-image-title h1#logo div.animation {
  transform: translateY(-2.1rem);
}
</style>
